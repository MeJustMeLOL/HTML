<?xml version="1.0" encoding="UTF-8"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing">
<w:body>
    <w:bookmarkStart w:id="20" w:name="header" />
    <w:bookmarkEnd w:id="20" />
    <w:bookmarkStart w:id="50" w:name="content" />
    <w:bookmarkStart w:id="29" w:name="X9e97bba6b78d8566e13accc96aeff0f1506d7f5" />
    <w:p><w:pPr><w:pStyle w:val="Heading1" /></w:pPr><w:r><w:t xml:space="preserve">Hệ thống pháp luật về phá sản tại Việt Nam</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="FirstParagraph" /></w:pPr><w:r><w:t xml:space="preserve">Hiện nay Việt Nam áp dụng</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Luật Phục hồi, phá sản 2025</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(số 142/2025/QH15, có hiệu lực từ 01/3/2026) thay thế</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Luật Phá sản 2014</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(số 51/2014/QH13, đã được sửa đổi bổ sung một số điều năm 2025)</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Luật mới mở rộng phạm vi điều chỉnh, bao gồm cả thủ tục phục hồi doanh nghiệp trước khi phá sản, đồng thời xác định rõ nguyên tắc, trình tự, thủ tục giải quyết vụ việc phục hồi và phá sản doanh nghiệp, hợp tác xã</w:t></w:r><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Các văn bản hướng dẫn thi hành quan trọng gồm: Nghị định 22/2015/NĐ-CP hướng dẫn chi tiết về</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">quản tài viên, doanh nghiệp quản lý thanh lý tài sản</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">trong phá sản</w:t></w:r><w:hyperlink r:id="rId23"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[3]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Nghị quyết 03/2016/NQ-HĐTP (Hội đồng Thẩm phán TANDTC) hướng dẫn một số quy định của Luật Phá sản (ví dụ về</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">tạm giữ tài sản, tham khảo án lệ</w:t></w:r><w:r><w:t xml:space="preserve">)</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId25"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[5]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Nghị quyết 81/2025/UBTVQH15 quy định về thẩm quyền địa phương (từ 1/7/2025,</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">chỉ ba Tòa án khu vực</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">xử lý toàn bộ vụ phá sản trong cả nước)</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; và Nghị định 64/2026/NĐ-CP quy định chi tiết thủ tục thi hành quyết định tuyên bố phá sản</w:t></w:r><w:hyperlink r:id="rId27"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[7]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Ngoài ra, theo Luật mới, các cơ quan quản lý nhà nước như cơ quan thuế, bảo hiểm xã hội cũng được bổ sung quyền nộp đơn yêu cầu mở thủ tục khi doanh nghiệp vi phạm nghĩa vụ tài chính</w:t></w:r><w:hyperlink r:id="rId28"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[8]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:bookmarkEnd w:id="29" />
    <w:bookmarkStart w:id="43" w:name="quy-trình-thủ-tục-phá-sản-sơ-lược" />
    <w:p><w:pPr><w:pStyle w:val="Heading1" /></w:pPr><w:r><w:t xml:space="preserve">Quy trình thủ tục phá sản (sơ lược)</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="FirstParagraph" /></w:pPr><w:r><w:t xml:space="preserve">Theo Luật hiện hành, doanh nghiệp (hoặc hợp tác xã) muốn phá sản phải</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">mất khả năng thanh toán</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(không trả được nợ sau 3 tháng kể từ ngày đến hạn) và được Tòa tuyên bố phá sản</w:t></w:r><w:hyperlink r:id="rId30"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[9]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId31"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[10]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Thủ tục phá sản thông thường bao gồm các bước chính sau:</w:t></w:r><w:r><w:br /></w:r><w:r><w:t xml:space="preserve">-</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Nộp đơn yêu cầu mở thủ tục</w:t></w:r><w:r><w:t xml:space="preserve">: Chỉ người có quyền (ví dụ: chủ doanh nghiệp, các chủ nợ – kể cả thuế và bảo hiểm xã hội, thành viên góp vốn lớn,…) mới được nộp đơn yêu cầu mở thủ tục phá sản</w:t></w:r><w:hyperlink r:id="rId28"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[8]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId32"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[11]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Đơn yêu cầu phải đính kèm hồ sơ chứng minh doanh nghiệp mất khả năng thanh toán và nộp phí phá sản.</w:t></w:r><w:r><w:br /></w:r><w:r><w:t xml:space="preserve">-</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Tòa án nhận và thụ lý đơn</w:t></w:r><w:r><w:t xml:space="preserve">: Trong 3 ngày làm việc kể từ khi nhận đơn hợp lệ, Tòa án phân công Thẩm phán hoặc tổ Thẩm phán xem xét đơn</w:t></w:r><w:hyperlink r:id="rId33"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[12]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Nếu đơn chưa hợp lệ, Tòa án yêu cầu bổ sung; nếu người nộp đơn không có quyền hoặc rút đơn, Tòa án trả lại đơn</w:t></w:r><w:hyperlink r:id="rId34"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[13]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Khi đủ điều kiện (đã nộp lệ phí), Tòa án ra</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">quyết định thụ lý</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">và thông báo công khai trong 3 ngày</w:t></w:r><w:hyperlink r:id="rId35"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[14]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Quyết định mở hay không mở thủ tục phá sản</w:t></w:r><w:r><w:t xml:space="preserve">: Trong vòng</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">30 ngày</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">kể từ ngày thụ lý đơn, Thẩm phán phải ra quyết định</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">mở hoặc không mở thủ tục phá sản</w:t></w:r><w:hyperlink r:id="rId36"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[15]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Quyết định này có hiệu lực ngay khi ban hành và được gửi cho đương sự, Tòa án, Viện KSND và các cơ quan liên quan trong 3 ngày</w:t></w:r><w:hyperlink r:id="rId36"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[15]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId37"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[16]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Trong 10 ngày kể từ khi nhận quyết định, các bên có quyền đề nghị xem xét lại, và Chánh án Tòa án giải quyết đề nghị đó trong 10 ngày</w:t></w:r><w:hyperlink r:id="rId37"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[17]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Biện pháp tạm thời</w:t></w:r><w:r><w:t xml:space="preserve">: Sau khi thụ lý, các bên (người nộp đơn, quản tài viên,…) có quyền yêu cầu Tòa án áp dụng ngay các biện pháp khẩn cấp tạm thời (ví dụ kê biên tài sản, đình chỉ hợp đồng) để bảo toàn tài sản doanh nghiệp và quyền lợi người lao động</w:t></w:r><w:hyperlink r:id="rId25"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[5]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Lập danh sách chủ nợ, thu nhập tài sản</w:t></w:r><w:r><w:t xml:space="preserve">: Sau khi mở thủ tục, quản tài viên phối hợp với doanh nghiệp thu thập và xác minh danh sách chủ nợ, tài sản, thu nhập của doanh nghiệp</w:t></w:r><w:hyperlink r:id="rId38"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[18]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Các chủ nợ gửi đơn đòi nợ trong thời hạn quy định để được đưa vào danh sách.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Họp chủ nợ</w:t></w:r><w:r><w:t xml:space="preserve">: Tòa án triệu tập</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Hội nghị chủ nợ lần thứ nhất</w:t></w:r><w:r><w:t xml:space="preserve">, đại diện ít nhất 51% tổng số nợ không bảo đảm tham gia mới hợp lệ; nếu không đủ thì phải hoãn và tiến hành lần hai</w:t></w:r><w:hyperlink r:id="rId39"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[19]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Tại Hội nghị chủ nợ, các chủ nợ thảo luận phương án xử lý (đình chỉ thủ tục phá sản, đề xuất phục hồi hoạt động kinh doanh hay đề nghị phá sản)</w:t></w:r><w:hyperlink r:id="rId40"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[20]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Nếu có phương án phục hồi kinh doanh được chấp thuận, thủ tục phá sản tạm đình chỉ; nếu không hoặc phương án phục hồi không thành công, Tòa án sẽ</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">tuyên bố doanh nghiệp phá sản</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Tuyên bố và thi hành quyết định phá sản</w:t></w:r><w:r><w:t xml:space="preserve">: Trường hợp tiếp tục phá sản, Thẩm phán ra quyết định tuyên bố doanh nghiệp phá sản</w:t></w:r><w:hyperlink r:id="rId31"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[10]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Sau đó, cơ quan thi hành án dân sự tiến hành</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">thanh lý tài sản phá sản</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">theo quy định của Chương VI của Luật Thi hành án dân sự</w:t></w:r><w:hyperlink r:id="rId27"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[7]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Nghị định 64/2026/NĐ-CP hướng dẫn chi tiết thủ tục thi hành quyết định phá sản, bao gồm lập tài khoản thu hồi tiền bán tài sản, giám sát quản tài viên, áp dụng biện pháp cưỡng chế nếu cần</w:t></w:r><w:hyperlink r:id="rId27"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[7]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId41"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[21]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Tài sản thu được được phân chia theo thứ tự ưu tiên: chi phí phá sản, nợ tiền lương, BHXH,… cuối cùng đến nợ không có bảo đảm, công nợ còn lại trả cho chủ doanh nghiệp hoặc cổ đông theo quy định</w:t></w:r><w:hyperlink r:id="rId42"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[22]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:bookmarkEnd w:id="43" />
    <w:bookmarkStart w:id="49" w:name="một-số-lưu-ý-và-thực-tiễn" />
    <w:p><w:pPr><w:pStyle w:val="Heading1" /></w:pPr><w:r><w:t xml:space="preserve">Một số lưu ý và thực tiễn</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Compact" /><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Thẩm quyền Tòa án</w:t></w:r><w:r><w:t xml:space="preserve">: Từ 1/7/2025, theo Nghị quyết 81/2025/UBTVQH15, tất cả vụ việc phá sản được chuyển giao xử lý tại ba Tòa án nhân dân khu vực (Hà Nội, Đà Nẵng, TP.HCM)</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Quy định này nhằm chuyên môn hóa giải quyết phá sản.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Compact" /><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Án lệ và hướng dẫn của TANDTC</w:t></w:r><w:r><w:t xml:space="preserve">: Luật Phá sản 2014 (và Luật Phục hồi, phá sản 2025) khuyến khích Thẩm phán tham khảo án lệ trong các vụ việc phá sản tương tự</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Đặc biệt, Nghị quyết 03/2016/NQ-HĐTP (sửa đổi năm 2025) hướng dẫn Thẩm phán áp dụng các biện pháp cấp bách tạm thời để bảo toàn tài sản và việc tham khảo các quyết định trước đó khi giải quyết phá sản</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId25"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[5]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Compact" /><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Thời hạn và thủ tục</w:t></w:r><w:r><w:t xml:space="preserve">: Luật quy định thời hạn chặt chẽ (30 ngày để quyết định mở/tạm ngưng), nhưng trên thực tế nhiều ý kiến chuyên gia cho rằng thời gian này quá ngắn với doanh nghiệp quy mô lớn</w:t></w:r><w:hyperlink r:id="rId44"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[23]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Ngoài ra, Luật hiện hành chưa có hướng dẫn chi tiết về mức phí phá sản và thủ tục nộp/tạm ứng phí, gây khó khăn trong thi hành</w:t></w:r><w:hyperlink r:id="rId45"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[24]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Một số quy định khác (về bù trừ nghĩa vụ, liên kết với Luật THADS) cũng được nhận xét là còn chồng chéo hoặc chưa phù hợp với thực tế và cần sửa đổi bổ sung</w:t></w:r><w:hyperlink r:id="rId46"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[25]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId47"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[26]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Compact" /><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Chuẩn bị hồ sơ, chi phí</w:t></w:r><w:r><w:t xml:space="preserve">: Người nộp đơn phải chịu trách nhiệm về thông tin nợ và tài sản</w:t></w:r><w:hyperlink r:id="rId38"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[18]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Tòa án có thể yêu cầu nộp trước lệ phí phá sản và tạm ứng chi phí quản lý phá sản. Luật mới bổ sung quy định về việc dự trù kinh phí này và mở tài khoản tập trung để nộp chi phí phá sản nhằm tăng minh bạch.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="FirstParagraph" /></w:pPr><w:r><w:t xml:space="preserve">Tóm lại, thủ tục phá sản ở Việt Nam hiện được điều chỉnh bởi Luật Phục hồi, phá sản 2025 và các văn bản hướng dẫn liên quan, theo đó doanh nghiệp mất khả năng thanh toán phải qua nhiều bước tố tụng (nộp đơn, thụ lý, mở/nộp đơn lại, họp chủ nợ, tuyên bố phá sản, thanh lý tài sản). Quá trình này được bảo đảm bằng các quy định pháp lý chặt chẽ, từ thẩm quyền Tòa án, thời hạn xử lý đến việc ưu tiên phân chia tài sản và giám sát quản tài viên. Đồng thời, thực tiễn thi hành luật đòi hỏi lưu ý về các quy định chi tiết, áp dụng án lệ và cân nhắc sửa đổi để khắc phục vướng mắc đã được chuyên gia đề xuất</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId44"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[23]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="BodyText" /></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Nguồn:</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Luật Phục hồi, phá sản 2025 và Luật Phá sản 2014 (hợp nhất, văn bản gốc)</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Nghị định 22/2015/NĐ-CP về quản tài viên</w:t></w:r><w:hyperlink r:id="rId23"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[3]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Nghị định 64/2026/NĐ-CP về thi hành án phá sản</w:t></w:r><w:hyperlink r:id="rId27"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[7]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Nghị quyết 03/2016/NQ-HĐTP của TANDTC</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId25"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[5]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Nghị quyết 81/2025/UBTVQH15 về thẩm quyền Tòa án</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; và các bài viết, hướng dẫn pháp lý liên quan</w:t></w:r><w:hyperlink r:id="rId48"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[27]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId44"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[23]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:bookmarkEnd w:id="49" />
