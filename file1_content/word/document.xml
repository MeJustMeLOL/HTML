<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing">
<w:body>
    <w:bookmarkStart w:id="20" w:name="header" />
    <w:bookmarkEnd w:id="20" />
    <w:bookmarkStart w:id="31" w:name="content" />
    <w:bookmarkStart w:id="30" w:name="Xefaa7afea5b124e7e0c5ec86230d98d21be8cf4" />
    <w:p><w:pPr><w:pStyle w:val="Heading1" /></w:pPr><w:r><w:t xml:space="preserve">Điều kiện pháp lý để doanh nghiệp bị tuyên bố phá sản</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="FirstParagraph" /></w:pPr><w:r><w:t xml:space="preserve">Theo pháp luật Việt Nam,</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">doanh nghiệp (DN) phá sản</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">khi cả hai điều kiện sau đây đồng thời xảy ra: (1) DN</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">mất khả năng thanh toán</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">các khoản nợ đến hạn; và (2) Tòa án ra</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">quyết định tuyên bố phá sản</w:t></w:r><w:r><w:t xml:space="preserve">. Khái niệm “mất khả năng thanh toán” được quy định rõ trong các văn bản pháp luật:</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Luật Phá sản 2014 (sửa đổi, bổ sung 2025)</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">định nghĩa: “Doanh nghiệp, hợp tác xã</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">mất khả năng thanh toán</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">là DN, HTX không thực hiện nghĩa vụ thanh toán khoản nợ trong thời hạn</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">03 tháng</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">kể từ ngày đến hạn thanh toán”</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Luật cũng quy định: “Phá sản là tình trạng của DN, HTX</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">mất khả năng thanh toán</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">và bị Tòa án nhân dân ra quyết định tuyên bố phá sản”</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Như vậy, dưới Luật Phá sản 2014, tiêu chí duy nhất để xác định “mất khả năng thanh toán” là DN</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">không trả nợ đúng hạn trong 3 tháng</w:t></w:r><w:r><w:t xml:space="preserve">. Tài sản của DN vẫn có thể còn nhiều nhưng nếu không trả nợ đúng hạn thì vẫn coi là đã mất khả năng thanh toán</w:t></w:r><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId23"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[3]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1001" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Luật Phục hồi, phá sản doanh nghiệp 2025 (số 142/2025/QH15)</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(có hiệu lực từ 01/3/2026) cập nhật khung thời gian: “DN, HTX</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">mất khả năng thanh toán</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">là DN, HTX không thực hiện nghĩa vụ thanh toán khoản nợ sau thời hạn</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">06 tháng</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">kể từ ngày đến hạn thanh toán”</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Luật mới cũng định nghĩa: “Phá sản là tình trạng của DN, HTX mất khả năng thanh toán và đã có quyết định tuyên bố phá sản của Tòa án”</w:t></w:r><w:hyperlink r:id="rId25"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[5]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Như vậy, sau 01/3/2026, DN phải không trả nợ sau 6 tháng kể từ hạn thì mới coi là mất khả năng thanh toán theo pháp luật hiện hành.</w:t></w:r></w:p>
    <w:bookmarkStart w:id="28" w:name="hướng-dẫn-của-tòa-án-và-thực-tiễn" />
    <w:p><w:pPr><w:pStyle w:val="Heading2" /></w:pPr><w:r><w:t xml:space="preserve">Hướng dẫn của Tòa án và thực tiễn</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="FirstParagraph" /></w:pPr><w:r><w:t xml:space="preserve">Tòa án nhân dân tối cao và cơ quan tư pháp đã có hướng dẫn cụ thể về việc xác định “mất khả năng thanh toán” và điều kiện tuyên phá sản:</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Công văn 199/TANDTC-PC (2020)</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">của TANDTC hướng dẫn: “DN, HTX không thanh toán nợ sau 3 tháng kể từ ngày đến hạn bao gồm hai trường hợp: (1) DN không có tài sản để trả nợ; (2) DN có tài sản nhưng không trả nợ”</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Công văn nhấn mạnh: mặc dù DN có tài sản khả dụng nhưng không trả nợ thì vẫn</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">đủ điều kiện mất khả năng thanh toán</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Đồng thời, việc DN kinh doanh có lãi hay có nhiều tài sản không làm thay đổi việc DN “mất khả năng thanh toán” nếu khoản nợ đến hạn chưa được thanh toán đúng hạn</w:t></w:r><w:hyperlink r:id="rId27"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[7]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Án lệ và phân tích thực tiễn</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">cũng khẳng định tiêu chí khách quan này. Ví dụ, trong một vụ việc về Công ty T, Tòa án đã tuyên hủy thủ tục phá sản vì cho rằng tài sản DN lớn gấp nhiều lần tổng nợ (trên 12.000 tỷ so với vài chục tỷ nợ). Tuy nhiên, tác giả phân tích cho rằng khái niệm “mất khả năng thanh toán” theo luật 2014 chỉ dựa trên việc</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">không trả nợ đúng hạn</w:t></w:r><w:r><w:t xml:space="preserve">, không phải dựa vào quy mô tài sản</w:t></w:r><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Như bài viết bình luận nêu rõ: “Chỉ tiêu để xác định mất khả năng thanh toán là hành vi không trả nợ đúng hạn”</w:t></w:r><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">, không phải giá trị tài sản của DN.</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0" /><w:numId w:val="1002" /></w:numPr></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Nghị quyết 03/2016/HĐTP-TANDTC</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">(sửa đổi bổ sung 2025) và các văn bản khác không đưa thêm tiêu chí mới nào ngoài quy định của luật. Tòa án cấp dưới áp dụng quy định pháp luật và Công văn hướng dẫn để quyết định mở hoặc đình chỉ thủ tục phá sản. Như vậy, căn cứ xác định điều kiện phá sản vẫn là sự</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">chậm trả nợ quá thời hạn luật định</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:bookmarkEnd w:id="28" />
    <w:bookmarkStart w:id="29" w:name="Xce376bff2d714df81ec2789096dba1c6660bb00" />
    <w:p><w:pPr><w:pStyle w:val="Heading2" /></w:pPr><w:r><w:t xml:space="preserve">Tóm tắt điều kiện phá sản và ví dụ minh họa</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="FirstParagraph" /></w:pPr><w:r><w:t xml:space="preserve">Tóm lại, các điều kiện theo quy định pháp luật hiện hành như sau:</w:t></w:r><w:r><w:br /></w:r><w:r><w:t xml:space="preserve">-</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Mất khả năng thanh toán:</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">DN hoặc HTX không thanh toán được</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">tất cả</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">các khoản nợ đã đến hạn trong thời hạn luật định (03 tháng theo luật cũ; 06 tháng theo Luật 2025)</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r><w:r><w:br /></w:r><w:r><w:t xml:space="preserve">-</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Quyết định tòa án:</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">DN đã được Tòa án thụ lý và ra quyết định tuyên bố DN phá sản.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="BodyText" /></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Ví dụ minh họa:</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Nếu theo Luật 2014, một DN có khoản nợ đến hạn 10 tỷ đồng và đã qua hơn 3 tháng kể từ ngày đến hạn mà vẫn chưa trả nợ, thì DN đó đã đủ điều kiện “mất khả năng thanh toán”. Khi tòa tuyên bố DN phá sản thì doanh nghiệp được coi là phá sản</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Trái lại, ngay cả khi DN có tài sản lớn nhưng không trả khoản nợ kịp hạn thì vẫn là mất khả năng thanh toán và có thể bị tuyên phá sản</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">. Sau 01/3/2026, điều kiện về thời gian là 6 tháng kể từ ngày đến hạn nợ theo Luật Phục hồi, phá sản 2025</w:t></w:r><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="BodyText" /></w:pPr><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">Nguồn:</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">Luật Phá sản 2014 và Luật Phục hồi, phá sản 2025 (Điều 4 Luật 2014; Điều 5 Luật 2025)</w:t></w:r><w:hyperlink r:id="rId21"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[1]</w:t></w:r></w:hyperlink><w:hyperlink r:id="rId24"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[4]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; Công văn 199/TANDTC-PC ngày 18/12/2020 của TANDTC</w:t></w:r><w:hyperlink r:id="rId26"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[6]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">; bài viết phân tích trường hợp đình chỉ thủ tục phá sản tại Tap chí Toà án</w:t></w:r><w:hyperlink r:id="rId22"><w:r><w:rPr><w:rStyle w:val="Hyperlink" /></w:rPr><w:t xml:space="preserve">[2]</w:t></w:r></w:hyperlink><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p>
    <w:bookmarkEnd w:id="29" />
